# OSSure frontend configuration. Copy to .env and fill in.
# Vite exposes only VITE_-prefixed vars to the browser. These are PUBLIC values
# (safe to ship in a client bundle) — never put a private key here.

# Privy App ID (https://dashboard.privy.io -> your app -> App ID).
VITE_PRIVY_APP_ID=

# Deployed OSSure contract address on Testnet Bradbury.
VITE_CONTRACT_ADDRESS=
